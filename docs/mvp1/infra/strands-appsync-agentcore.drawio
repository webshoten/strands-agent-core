        <mxCell id="legend-step-7-text" value="&lt;b&gt;WebSocket配信&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;AgentCoreがIAM認証でAppSync Eventsへ出力を発行し、既存のWebSocket接続からReactへ配信する。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontColor=light-dark(#232F3E,#F3F5F7);fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1725" y="628" width="500" height="76" as="geometry"/>

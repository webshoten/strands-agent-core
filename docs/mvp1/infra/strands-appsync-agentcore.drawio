        <mxCell id="legend-step-2-text" value="&lt;b&gt;React配信&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;CloudFrontがOACを使用して非公開S3からReactの静的ファイルを配信する。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontColor=light-dark(#232F3E,#F3F5F7);fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1725" y="193" width="500" height="66" as="geometry"/>
        </mxCell>


          <mxGeometry x="1670" y="280" width="40" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="legend-step-3-text" value="&lt;b&gt;開始要求と購読&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;ReactがCloudFront経由でAppSync Eventsへ接続し、開始イベントを送り、セッションチャネルを購読する。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontColor=light-dark(#232F3E,#F3F5F7);fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1725" y="278" width="500" height="76" as="geometry"/>
        </mxCell>


          <mxGeometry x="1670" y="455" width="40" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="legend-step-5-text" value="&lt;b&gt;非同期開始&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;AppSync EventsのonPublishがEVENTモードで開始Lambdaを呼び出す。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontColor=light-dark(#232F3E,#F3F5F7);fontFamily=Helvetica;" vertex="1" parent="1">
